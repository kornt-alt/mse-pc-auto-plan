# ===== API base — client.js อ่านค่านี้ (มี fallback เป็น localhost ถ้าไม่ตั้ง) =====
# ⚠️ ค่านี้ถูก inline เข้า bundle ตอน build ต้องตั้งให้ถูก "ก่อน" npm run build ทุกครั้ง
#   dev (npm start)          : http://localhost:5000/api   ← หรือ :3100 ถ้ารัน backend คนละพอร์ต
#   build ขึ้นโรงงาน (IIS)     : /MSE-PC-AUTO-PLAN/api      ← ต้องเป็นค่านี้เท่านั้น
# เดิมมีไฟล์ .env.production คอยจ่ายค่าให้ตอน build แต่มันจ่าย '/api' ซึ่งไม่มีอะไรรับ
# (rule ใน web.config match '^api/' เทียบกับ application root '/MSE-PC-AUTO-PLAN')
# จึงลบไฟล์นั้นทิ้งแล้ว → ตอนนี้เหลือไฟล์ .env ไฟล์เดียวที่ต้องแก้เอง
# และ .env ถูก .gitignore ไว้ **ไม่มีใครเห็นตอนลืม** — เช็คทุกครั้งก่อน build ขึ้น production
REACT_APP_API_BASE=http://localhost:5000/api

# ===== Hana API (SAP COOIS) — การ์ด "ดึง Order จาก SAP" ในหน้า Import =====
# ตัวอย่างที่ยิงได้จริง:
#   https://plb044.lb.minebea.local/SAPGWAPIS/api/hana/coois/plant=LB69/createdOnFrom=20260801/materialDesc=ELEMENT/onlyHaveConfirmQty=true
REACT_APP_HANA_URL=https://plb044.lb.minebea.local/SAPGWAPIS/api/hana/coois
REACT_APP_HANA_TOKEN=
# ค่าเริ่มต้นของช่อง Plant ในฟอร์ม
REACT_APP_HANA_DEFAULT_PLANT=LB69

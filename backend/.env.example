# Server
PORT=5000
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=24h

# Database (SQL Server)
# DB_AUTH=windows ใช้ Trusted Connection (ต้องมี ODBC Driver 17)
# DB_AUTH=sql ใช้ SQL Login (ต้องกรอก DB_USER/DB_PASSWORD)
DB_AUTH=windows
DB_SERVER=SERVERNAME\SQLEXPRESS
DB_NAME=MSE
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10

# Files / integration
CSV_BASE_DIR=C:\path\to\csv\dir
DRAWINGS_DIR=C:\path\to\drawings
# โฟลเดอร์เก็บไฟล์แนบของ Release/Material/Confirm (order_date_log) — Node ต้องเขียนได้
ORDER_ATTACHMENTS_DIR=C:\path\to\order_attachments
SAP_PYTHON_EXE=python
SAP_SCRIPT_PATH=C:\path\to\sap_script.py
SAP_TIMEOUT_MS=300000

# Hana API (SAP COOIS) — ไม่มีค่าที่นี่โดยตั้งใจ
# เครื่อง server อยู่ใน DMZ ไม่มีเส้นทางไป plb044 มีแต่เครื่อง client ที่ถึง
# → การ์ด "ดึง Order จาก SAP" ยิงจาก browser เอง ตั้งค่าที่ frontend/.env (REACT_APP_HANA_*)
# ไม่มี route ฝั่งนี้เลย — passthrough ที่เคยเขียนถูกลบทิ้งแล้ว (ดู index.js)

# Mail relay ภายใน LAN — ใช้เมื่อ server ตัดเน็ต ยิง Gmail (SMTP) ตรงไม่ได้
# ตั้งค่านี้แล้ว ระบบจะยิง HTTP ไปเครื่อง relay แทน (relay ถือ credential + ออกเน็ตเอง) → SMTP_* ด้านล่างถูกข้าม
# เว้นว่างไว้ = ใช้ SMTP ตรงตามปกติ
MAIL_RELAY_URL=
#MAIL_RELAY_URL=http://<relay-host>:4000/api/send-mail
MAIL_RELAY_TIMEOUT_MS=8000

# Mail (แจ้งเตือน missing routing)
# ผู้รับ To/CC เก็บในตาราง alert_recipients (จัดการผ่านหน้าเว็บ) — ที่นี่มีแค่ผู้ส่ง/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=app-password-here
MAIL_FROM=sender@example.com
# URL ของหน้าเว็บ ใช้ใส่ลิงก์ในอีเมลแจ้ง ADMIN ตอนมีคนสมัครใหม่ (เว้นว่างได้ = เมลไม่มีลิงก์)
APP_URL=http://localhost:5000/MSE-PC-AUTO-PLAN

# App config
DEFAULT_CALENDAR_MINUTES=1240
# DEFAULT_USER_SEED ถูกยกเลิกแล้ว (2026-08-15) พร้อมกับ POST /auth/create-default-users
# endpoint นั้นล้าง users ทั้งตารางก่อน seed ใหม่ และใช้ bootstrap ไม่ได้อยู่แล้ว (ต้องมี ADMIN ก่อนถึงเรียกได้)
# สร้าง ADMIN คนแรกบน DB เปล่า → INSERT ด้วย SQL โดยตรง (password_hash เป็น bcrypt)
# กรอกรหัสพนักงานเข้าหน้าไลน์ผลิตได้แม้ไม่มีบัญชีใน users (สิทธิ์ OPERATOR เท่านั้น) — false = ต้องมีบัญชีก่อน
ALLOW_GUEST_SCAN=true

# แก้/ลบ production_records ได้เฉพาะแถวที่รหัสพนักงานตรงกับ session (ADMIN/PLANNER/MFG ข้ามได้)
# ตั้ง false ถ้าหน้างานใช้แท็บเล็ตร่วมกัน (ล็อกอินค้างไว้แล้วให้คนอื่นสแกนรหัสตัวเองลงยอด) แล้วติดปัญหา
# false = กลับไปพฤติกรรมเดิมคือไม่เช็คเจ้าของเลย (ดู utils/recordAccess.js)
STRICT_RECORD_OWNERSHIP=true

# origin ที่อนุญาตให้เรียก API ข้ามโดเมน คั่นด้วยคอมมา
# **เว้นว่าง = ไม่ส่ง CORS header เลย** ซึ่งเป็นค่าที่ถูกต้องสำหรับ production (หน้าเว็บกับ API
# อยู่ origin เดียวกันผ่าน IIS อยู่แล้ว) — ⚠️ dev ต้องตั้ง ไม่งั้น npm start (:3000) ยิง backend ไม่ได้
CORS_ORIGINS=http://localhost:3000

# Scheduler overrides (default ตรงกับระบบเดิม)
#SCHED_MIN_FRAGMENT_TIME=120
#SCHED_SWITCH_PENALTY_MIN=60
#SCHED_MINOR_SETUP_MIN=40
#SCHED_PACK_WINDOW_DAYS=30
# เตือนล่วงหน้าว่าปฏิทินใกล้หมด (วัน) — GET /api/system/calendar-horizon
#SCHED_CALENDAR_WARN_DAYS=30
#SCHED_CALENDAR_CRITICAL_DAYS=7
#SCHED_DAY_UNIT_KEYWORDS=PREPARE-OUTSOURCE,OUTSOURCE,HEAT-TREATMENT,HEAT_JUTAWAN,DEBURR-INSEPC,BLACKENING_CCS,OQC,ROUGH_TURNING_CCS
